{
  "manifest_version": 3,
  "name": "Bookmarkit",
  "version": "0.1.0",
  "description": "A local-first reading list.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["activeTab"],
  "action": {
    "default_title": "Bookmarkit",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  }
}
